    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "jinr_infinity" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "step" },
            "properties": [{ "id": "custom.width", "value": 50 }] },
          { "matcher": { "id": "byName", "options": "action_id" },
            "properties": [{ "id": "custom.width", "value": 180 }] },
          { "matcher": { "id": "byName", "options": "priority" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                  { "color": "blue", "value": null }
              ]}},
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                  "critical": { "color": "red",    "index": 0 },
                  "high":     { "color": "orange", "index": 1 },
                  "medium":   { "color": "yellow", "index": 2 },
                  "low":      { "color": "green",  "index": 3 }
                }}
              ]}
            ]
          },
          { "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                  "pending":  { "color": "yellow", "index": 0 },
                  "done":     { "color": "green",  "index": 1 },
                  "failed":   { "color": "red",    "index": 2 }
                }}
              ]}
            ]
          }
        ]
