# =========================================================================
# GNN RCA System Configuration
# =========================================================================
# Copy this file to .env and modify as needed

# =========================================================================
# Layer 1: Knowledge Base Configuration
# =========================================================================

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_secret_key
QDRANT_TIMEOUT=30

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# =========================================================================
# Layer 2: LLM Configuration
# =========================================================================

# Ollama (Local LLM Server)
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=mistral
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# Alternative: Remote LLM API (comment out Ollama above if using)
# LLM_BACKEND=remote
# LLM_API_KEY=your_api_key_here
# LLM_API_BASE=https://api.example.com/v1

# =========================================================================
# Application Configuration
# =========================================================================

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/artifacts/app.log

# Data paths (inside Docker)
INFERENCE_PATH=/app/artifacts/inference_sample.json
REPORT_PATH=/app/artifacts/remediation_report.json
CHECKPOINT_PATH=/app/checkpoints/best_model.pt
DATASET_PATH=/app/dataset/raw

# =========================================================================
# Debug & Testing
# =========================================================================

# Enable debug logging
DEBUG=false

# Force rule-based fallback (disable LLM)
FORCE_RULE_BASED=false

# Skip firewall validation (unsafe, testing only)
SKIP_FIREWALL=false

# Disable caching
DISABLE_CACHE=false

# =========================================================================
# Performance Tuning
# =========================================================================

# Number of RAG results to retrieve
RAG_TOP_K=5

# Number of historical incidents to consider
HISTORY_LIMIT=3

# Batch size for processing multiple incidents
BATCH_SIZE=1

# Max concurrent requests
MAX_CONCURRENT=4

# =========================================================================
# Monitoring & Observability
# =========================================================================

# Prometheus metrics
METRICS_ENABLED=false
METRICS_PORT=9090

# Jaeger tracing
TRACING_ENABLED=false
JAEGER_HOST=jaeger
JAEGER_PORT=6831

# =========================================================================
# Security
# =========================================================================

# API authentication (optional)
API_KEY=
API_SECRET=

# TLS/SSL (optional)
USE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# =========================================================================
# Docker Compose
# =========================================================================

# Image versions
QDRANT_IMAGE=qdrant/qdrant:latest
REDIS_IMAGE=redis:7-alpine
OLLAMA_IMAGE=ollama/ollama:latest
PYTHON_IMAGE=python:3.12-slim
